  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"API,VITE\" -c \"cyan,magenta\" \"npm:server:watch\" \"vite\"",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "server:watch": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "npm run build && npm run server",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke-test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^14.7.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.5"
